<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<!-- No Dock icon and no menu bar of its own. Orate is reached by its shortcut and by
	     the status item; a Dock icon for something used thirty times a day and never
	     looked at is clutter. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Shown verbatim in the system prompt, so it has to answer the question the user is
	     actually asking at that moment, which is not "why" but "what happens to it". -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Orate turns what you say into text on this Mac. The audio is transcribed on device and then discarded. It is never uploaded and never stored.</string>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Zain Najam. All rights reserved.</string>
</dict>
</plist>
